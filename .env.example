# Google Gemini API Key for Prescription OCR & Drug Interaction Checking
GEMINI_API_KEY=your_gemini_api_key_here

# App URL (for email notification links and webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Notification Service (Optional: Nodemailer / Resend / Ethereal Test)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_FROM=ayucare-alerts@healthcare.org
CAREGIVER_NOTIFICATION_EMAIL=caregiver@example.com
